{
  "schema_version": 8,
  "enabled": true,
  "general": {
    "start_hidden": true,
    "close_to_tray": true,
    "autostart": true,
    "notifications": false,
    "sound": false,
    "keep_history": false
  },
  "detection": {
    "layouts": [
      "us",
      "ru"
    ],
    "language_models": [
      "en_US",
      "ru_RU"
    ],
    "minimum_length": 3,
    "confidence": 2.0,
    "correct_on_pause": false,
    "pause_delay_seconds": 0.7,
    "early_switch": false,
    "early_switch_min_length": 4,
    "correct_on_space": true,
    "correct_on_enter": true,
    "correct_on_tab": true,
    "correct_on_punctuation": true,
    "respect_manual_layout": true,
    "layout_switch_key": "",
    "fix_double_capitals": false,
    "aggressive": false,
    "context_aware": true,
    "context_policy": "assist",
    "context_read_field": true,
    "hold_after_caret_move": true,
    "field_catch_up": "300",
    "protect_code": true,
    "intent_model_enabled": true,
    "correct_typos": false,
    "correct_typos_english": false,
    "learning": true,
    "injected_input": false
  },
  "hotkeys": {
    "toggle": "Ctrl+Alt+P",
    "convert_last": "Pause",
    "undo": "Ctrl+Alt+Z",
    "selection_layout": "Shift+Pause",
    "selection_case": "Alt+Pause",
    "selection_transliterate": "Alt+Scroll_Lock"
  },
  "appearance": {
    "theme": "system",
    "show_indicator": true,
    "indicator_style": "letters"
  },
  "updates": {
    "check_automatically": false,
    "install_automatically": false
  },
  "diagnostics": {
    "technical_logging": false
  },
  "history": {
    "limit": 200
  },
  "exclusions": {
    "applications": [],
    "words": []
  }
}
