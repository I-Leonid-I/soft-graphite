[Desktop Entry]
Name=Google Groupware
Comment=Access Google Calendars, Contacts and Tasks from KDE
Type=AkonadiResource
Exec=@HOME@/.local/share/soft-graphite/native/google-tasks/launch.py
X-Akonadi-MimeTypes=text/calendar,text/directory,application/x-vnd.akonadi.calendar.event,application/x-vnd.akonadi.calendar.todo,application/x-vnd.akonadi.calendar.freebusy
X-Akonadi-Capabilities=Resource,FreeBusyProvider
X-Akonadi-Identifier=akonadi_google_resource
X-Akonadi-Custom-KAccounts=google-contacts,google-calendar
Icon=account-google
