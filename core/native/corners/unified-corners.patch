diff --git a/src/shaders/shapecorners.glsl b/src/shaders/shapecorners.glsl
index 1f44c9c..e00f140 100644
--- a/src/shaders/shapecorners.glsl
+++ b/src/shaders/shapecorners.glsl
@@ -1,5 +1,28 @@
 #include "shapecorners_shadows.glsl"
 
+uniform vec4 clientRect;
+uniform float clientCornerLimit;
+
+// A client can keep its own transparent rounded cut-outs after KWin adds a
+// server titlebar. Seal only those cut-outs immediately below the titlebar.
+// Sample the client's own edge colour; never replace opaque application pixels.
+// This runs in the existing pass, with no readback, timer or application list.
+vec4 sealClientCorners(vec2 pixel, vec4 tex)
+{
+    if (clientRect.z <= 0.0 || tex.a >= 0.999) return tex;
+    vec2 p = pixel - clientRect.xy;
+    float side = min(p.x, clientRect.z - p.x);
+    if (p.y < 0.0 || p.y >= clientCornerLimit || side < 0.0 || side >= clientCornerLimit) return tex;
+
+    float insetX = p.x < clientRect.z * 0.5 ? clientCornerLimit + 0.5 : clientRect.z - clientCornerLimit - 0.5;
+    vec4 horizontal = texture2D(sampler, pixel_to_tex(clientRect.xy + vec2(insetX, p.y)));
+    vec4 vertical = texture2D(sampler, pixel_to_tex(clientRect.xy + vec2(p.x, clientCornerLimit + 0.5)));
+    // Keep genuinely translucent clients translucent. Both neighbouring edges
+    // must be opaque before treating a missing corner as a CSD cut-out.
+    if (horizontal.a < 0.995 || vertical.a < 0.995) return tex;
+    return vec4(tex.rgb + vertical.rgb * (1.0 - tex.a), 1.0);
+}
+
 bool is_within(float point, float a, float b) { return (point >= min(a, b) && point <= max(a, b)); }
 bool is_within(vec2 point, vec2 corner_a, vec2 corner_b)
 {
@@ -158,6 +181,7 @@ vec4 shapeCorner(vec2 coord0, vec4 tex, vec2 start, float angle, vec4 coord_shad
 
 vec4 run(vec2 texcoord0, vec4 tex)
 {
+    tex = sealClientCorners(tex_to_pixel(texcoord0), tex);
     if (tex.a == 0.0) {
         return tex;
     }
